{
  "name": "anibalealvarezs/typesafe-api",
  "description": "Standalone PHP SDK for interacting with TypeSafe AI (JEV System One) API, providing calibrated judgment and semantic classification.",
  "license": "MIT",
  "keywords": [
    "typesafe",
    "jev",
    "system-one",
    "ai",
    "classification",
    "semantic",
    "calibrated-judgment",
    "sdk",
    "php"
  ],
  "homepage": "https://github.com/anibalealvarezs/typesafe-api",
  "authors": [
    {
      "name": "Aníbal Álvarez",
      "email": "anibalealvarezs@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/anibalealvarezs/typesafe-api/issues"
  },
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.0",
    "symfony/yaml": "^6.0 || ^7.0",
    "anibalealvarezs/api-client-skeleton": "^1.0.0"
  },
  "autoload": {
    "psr-4": {
      "Anibalealvarezs\\TypeSafeApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "phpstan/phpstan": "^1.10"
  },
  "scripts": {
    "test": "phpunit --bootstrap tests/bootstrap.php tests",
    "test-unit": "phpunit --bootstrap tests/bootstrap.php tests/Unit",
    "test-integration": "phpunit --bootstrap tests/bootstrap.php tests/Integration"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://satis.anibalalvarez.com/"
    }
  ]
}
